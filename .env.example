# =============================================================
# BANCO DE DADOS MARIADB (GLPI)
# =============================================================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=nome_do_banco
DB_USER=user_do_banco
DB_PASS=senha_do_banco

# =============================================================
# SERVIDOR DE E-MAIL (SMTP)
# Gmail com verificação em duas etapas exige "senha de app",
# não a senha normal da conta.
# =============================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu_usuario
SMTP_PASS=sua_senha
SMTP_FROM=seu_email@gmail.com

# =============================================================
# DESTINATÁRIOS GERAIS POR ÁREA (separados por vírgula, sem
# espaços). Usados como destinatário padrão de TODOS os tipos
# de relatório daquela área (mensal/semanal/críticos), a menos
# que a variável GRUPO_*_MENSAL/SEMANAL/CRITICOS específica
# abaixo seja preenchida.
# =============================================================
DESTINATARIOS_SUPORTE_N1=destinatario@exemplo.com
DESTINATARIOS_SUPORTE_N2=destinatario@exemplo.com
DESTINATARIOS_ADMSIS=destinatario@exemplo.com
DESTINATARIOS_REDES=destinatario@exemplo.com
DESTINATARIOS_DEV=destinatario@exemplo.com
DESTINATARIOS_DIRETORIA=destinatario@exemplo.com

# =============================================================
# OVERRIDES OPCIONAIS POR TIPO DE RELATÓRIO
#
# Deixe essas linhas COMENTADAS/ausentes para usar sempre o
# DESTINATARIOS_* da área acima (comportamento padrão).
# Descomente e preencha apenas se algum tipo de relatório
# precisar ir para uma lista diferente da geral — por exemplo,
# alertas críticos indo para o plantão, e mensal/semanal indo
# para o coordenador.
#
# GRUPO_SUPORTE_N1_MENSAL=coordenador@exemplo.com
# GRUPO_SUPORTE_N1_SEMANAL=coordenador@exemplo.com
# GRUPO_SUPORTE_N1_ANUAL=coordenador@exemplo.com
# GRUPO_SUPORTE_N1_CRITICOS=plantao@exemplo.com
#
# GRUPO_SUPORTE_N2_MENSAL=coordenador@exemplo.com
# GRUPO_SUPORTE_N2_SEMANAL=coordenador@exemplo.com
# GRUPO_SUPORTE_N2_ANUAL=coordenador@exemplo.com
# GRUPO_SUPORTE_N2_CRITICOS=plantao@exemplo.com
#
# GRUPO_ADMSIS_MENSAL=coordenador@exemplo.com
# GRUPO_ADMSIS_SEMANAL=coordenador@exemplo.com
# GRUPO_ADMSIS_ANUAL=coordenador@exemplo.com
# GRUPO_ADMSIS_CRITICOS=plantao@exemplo.com
#
# GRUPO_REDES_MENSAL=coordenador@exemplo.com
# GRUPO_REDES_SEMANAL=coordenador@exemplo.com
# GRUPO_REDES_ANUAL=coordenador@exemplo.com
# GRUPO_REDES_CRITICOS=plantao@exemplo.com
#
# GRUPO_DEV_MENSAL=coordenador@exemplo.com
# GRUPO_DEV_SEMANAL=coordenador@exemplo.com
# GRUPO_DEV_ANUAL=coordenador@exemplo.com
# GRUPO_DEV_CRITICOS=plantao@exemplo.com
# =============================================================

# =============================================================
# ALERTA DE FALHA (scripts/alerta_falha.py, disparado via
# OnFailure= dos units systemd)
#
# scripts/alerta_falha.py reutiliza DESTINATARIOS_DIRETORIA acima —
# não existe (e não deve ser criada aqui) uma variável
# DESTINATARIOS_ALERTA separada, porque config/settings.py não a lê.
#
# ZABBIX_SERVER/ZABBIX_HOST identificam pra qual servidor Zabbix e sob
# qual "Host name" cadastrado lá o trap de falha é enviado. Cada
# ambiente (lab, produção) tem seu próprio host no Zabbix — preencha
# com o valor real deste ambiente; sem isso, cai no padrão do lab.
# =============================================================
ZABBIX_SERVER=10.14.8.23
ZABBIX_HOST=AUTOMACAO-GLPI-LAB

# =============================================================
# RODAPÉ DO E-MAIL (opcional — em branco, o template simplesmente
# não exibe a linha)
# =============================================================
EMAIL_RODAPE_LINHA1=Seu Nome | Sua Equipe
EMAIL_RODAPE_LINHA2=Sua Organização

# =============================================================
# LOG (opcional — todos têm padrão sensato se omitidos)
# =============================================================
LOG_FORMAT=text

# =============================================================
# TETO DE TAMANHO DO ANEXO EXCEL (opcional, em MB)
# =============================================================
ANEXO_TAMANHO_ALERTA_MB=10
ANEXO_TAMANHO_MAXIMO_MB=20
