[Unit]
Description=Automacao GLPI - Relatorio: %i
After=network.target
OnFailure=automacao-glpi-alerta@%n.service

[Service]
Type=oneshot
User=automacaoglpi
Group=automacaoglpi
WorkingDirectory=/opt/automacaoGLPI
ExecStart=/opt/automacaoGLPI/venv/bin/python3 main.py --report %i

# Boas práticas de log e reiniciar em falhas temporárias
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target